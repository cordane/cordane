# cordane self-host config. Copy to `.env` (same folder) and fill in.
# Compose auto-loads `.env`. NEVER commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hostnames ────────────────────────────────────────────────────────────────
# Control-plane URL (how browsers reach the hub). Must be https in production.
EXTERNAL_URL=https://cordane.example.com
# Hostname Caddy serves the hub on (usually EXTERNAL_URL without the scheme).
CONTROL_HOST=cordane.example.com
# ── TLS mode ─────────────────────────────────────────────────────────────────
# SIMPLE MODE (the default here): one hostname, a normal HTTPS certificate, no
# DNS API token. App previews are served path-based at /w/{worker}/{app}/.
# All you need is a DNS A record for CONTROL_HOST pointing at this machine.
CADDYFILE=Caddyfile.pathbased
# App previews on their own subdomains (*.PROXY_DOMAIN — better isolation, and
# apps that use absolute URLs or websockets work). Leave BLANK in simple mode.
# To switch: set CADDYFILE=Caddyfile, PROXY_DOMAIN (often = CONTROL_HOST),
# CF_API_TOKEN below, and a wildcard DNS record — see deploy/README.md.
PROXY_DOMAIN=

# ── Wildcard mode only ───────────────────────────────────────────────────────
# Cloudflare API token with Zone:DNS:Edit on the served zone(s), for the DNS-01
# wildcard cert. Not needed in simple mode.
CF_API_TOKEN=
# Optional: email for ACME cert-expiry notices.
ACME_EMAIL=

# ── Required secrets ─────────────────────────────────────────────────────────
# Encrypts app/profile env vars at rest (AES-256-GCM). Generate once:
#   openssl rand -base64 32
# ⚠ BACK THIS UP OUT-OF-BAND. If lost, encrypted env vars are unrecoverable and
#   it is NOT in the litestream backup.
CORDANE_SECRET_KEY=

# GitHub OAuth App (the only sign-in method). Callback URL:
#   ${EXTERNAL_URL}/api/v1/auth/github/callback
CORDANE_GITHUB_CLIENT_ID=
CORDANE_GITHUB_CLIENT_SECRET=

# ── Licensing (optional) ─────────────────────────────────────────────────────
# Blank = free community tier: 1 worker, 1 project, 2 users, 3 concurrent agent
# runs. A Team key lifts workers/projects/concurrency to unlimited and caps users
# at your seat count. Every feature is on in every tier — the only gate is these
# counts. Buy a key at https://cordane.ai. With a key, the server checks in daily and works
# offline within a ~35-day grace window (a Cordane outage never blocks you).
CORDANE_LICENSE_KEY=
# Override the license issuer URL (default https://cordane.ai). Only for testing
# against a local cordane_ai; leave blank in production.
# CORDANE_LICENSE_SERVER=
# The hub checks cordane.ai daily for a newer build and shows admins an "update
# available" banner (Settings → Version). It never changes anything itself — you
# still run `docker compose pull && up -d`. Set to `off` to disable the check
# (air-gapped / privacy). CORDANE_UPDATE_CHANNEL selects the release line (stable).
# CORDANE_UPDATE_CHECK=off
# CORDANE_UPDATE_CHANNEL=stable

# ── Backups to object storage (optional; all blank = disabled) ───────────────
# Any S3-compatible store. Example values are for Cloudflare R2 (free egress).
# LITESTREAM_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# LITESTREAM_BUCKET=cordane-backups
# LITESTREAM_PATH=cordane.db
# LITESTREAM_REGION=auto
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_ENDPOINT=
LITESTREAM_BUCKET=
LITESTREAM_PATH=cordane.db
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── Alert email (optional) ───────────────────────────────────────────────────
# Lets members get "agent is stuck / run failed / ready for review" alerts by
# email (Settings → Alerts). Blank = email unavailable; webhooks and browser
# notices still work. SECURITY: starttls (default for 587) | tls (465) | none.
CORDANE_SMTP_HOST=
CORDANE_SMTP_PORT=
CORDANE_SMTP_FROM=
CORDANE_SMTP_USERNAME=
CORDANE_SMTP_PASSWORD=
CORDANE_SMTP_SECURITY=

# ── Private-network targets (optional, default off) ──────────────────────────
# =1 lets Sentry/Jira/GitHub/Linear connections reach loopback/private hosts and
# plain http (a self-hosted Jira on your LAN). Webhooks have their OWN switch,
# so opening one never opens the other. Cloud metadata (link-local) stays blocked.
CORDANE_ALLOW_PRIVATE_CONNECTIONS=
CORDANE_ALLOW_PRIVATE_WEBHOOKS=
